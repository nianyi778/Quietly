{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Quietly",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project", "Quietly.xcodeproj",
                "-scheme", "Quietly",
                "-configuration", "Debug",
                "-derivedDataPath", "./build",
